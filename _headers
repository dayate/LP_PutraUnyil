# Cloudflare Pages — header keamanan & cache
# CATATAN: file ini hanya berlaku bila HTML disajikan sebagai static asset Pages.
# Jika deployment memakai Worker yang me-return index.html sendiri, header di
# bawah harus dipasang manual di dalam fetch handler.
#
# Sejak Fase 1 tidak ada lagi CDN eksternal (Tailwind, Leaflet, Google Fonts
# semuanya di-host sendiri), jadi CSP bisa jauh lebih ketat.
# script-src masih butuh 'unsafe-inline' karena tombol memakai atribut onclick.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self'; font-src 'self'; img-src 'self' data: https://server.arcgisonline.com; connect-src 'self' https://photon.komoot.io https://cloudflareinsights.com; frame-src https://www.google.com https://maps.google.com https://maps.google.co.id; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests

# HTML selalu revalidasi supaya update cepat sampai ke pengunjung
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Status stok: selalu revalidasi supaya perubahan cepat terlihat
/stock.json
  Cache-Control: public, max-age=0, must-revalidate

# Aset statis: font & WebP aman di-cache lama (nama file tidak berubah isinya)
/fonts/*
  Cache-Control: public, max-age=31536000

/vendor/*
  Cache-Control: public, max-age=31536000

# CSS/JS di-cache 7 hari, TETAPI direferensikan dengan ?v=<hash isi>
# (lihat scripts/cache-bust.js). Setiap perubahan menghasilkan URL baru,
# jadi cache lama tidak akan pernah menyajikan kode usang.
/assets/*
  Cache-Control: public, max-age=604800

/images/*
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/og-image.jpg
  Cache-Control: public, max-age=604800
